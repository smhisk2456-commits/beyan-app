<?xml version="1.0" encoding="utf-8"?>
<!-- Android Widget Layout - Kilit ve Ana Ekran İçin -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Üst Satır: Sure Referansı + Ay İkonu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fatiha 1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Ayet Metni (Kullanıcının belirlediği dakikada bir otomatik değişir) -->
    <TextView
        android:id="@+id/widget_ayah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:text="Rahman ve Rahim olan Allah'ın adıyla"
        android:textColor="#E0F2F1"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Namaz Bilgisi Satırı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Öğle 13:00"
            android:textColor="#80CBC4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="• 02:45 kaldı"
            android:textColor="#B2DFDB"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
